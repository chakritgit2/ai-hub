# Base URL of console-api (Phalcon), e.g. https://console-api.internal.example.com/admin/v1
# For local dev, use a relative path instead — console-api sets no CORS headers (by
# design, see vite.config.ts), so `vite dev`'s proxy forwards same-origin requests to it.
PUBLIC_CONSOLE_API_BASE_URL=/admin/v1

# Base URL of ai-runtime's public Playground surface (PRD §4.4-B, §9.3), e.g.
# https://ai-runtime.internal.example.com/ai/v1 — the browser opens SSE here directly
# (with a short-lived runtime token from /runtime-token above), not through console-api.
# Same relative-path-plus-vite-proxy local dev setup as PUBLIC_CONSOLE_API_BASE_URL.
PUBLIC_AI_RUNTIME_BASE_URL=/ai/v1
