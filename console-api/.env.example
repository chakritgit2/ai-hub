# console-api environment configuration (PRD-001 §8.1, §11)
# Copy to .env for local development. Real secrets are injected via k8s Secrets in staging/production.

APP_ENV=local
APP_DEBUG=true

# --- Database -----------------------------------------------------------
# console-api connects with the `console_app` role (read/write `console` schema,
# read-only on selected `runtime`/`logs` tables) — see db/migrations/pre/001_schemas_roles_extensions.sql.
# platform_admin requests additionally use `console_platform` (cross-company read policies).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ai_console
DB_SCHEMA=console
DB_APP_USER=console_app
DB_APP_PASSWORD=changeme_local_dev_only
DB_PLATFORM_USER=console_platform
DB_PLATFORM_PASSWORD=changeme_local_dev_only
# Role used only by Phinx migrations (owns the tables) — never used by the app at request time.
DB_OWNER_USER=db_owner
DB_OWNER_PASSWORD=changeme_local_dev_only

# --- SSO / JWT (PRD §7.1, §7.6) ------------------------------------------
# JWKS published by the existing Phalcon system; console-api verifies inbound SSO JWTs against it.
SSO_JWKS_URL=https://sso.example.internal/.well-known/jwks.json
SSO_ISSUER=https://sso.example.internal
SSO_AUDIENCE=dynamiq-console

# console-api's own signing key, used for:
#   - the 5-minute Playground runtime token (console-api -> ai-runtime), PRD §4.4-B
#   - the 60-second internal call token (console-api -> ai-runtime /internal/v1/*), aud=ai-internal
CONSOLE_JWT_PRIVATE_KEY_PATH=./keys/console-signing-key.pem
CONSOLE_JWT_KID=console-2026-09
CONSOLE_JWKS_PATH=/admin/.well-known/jwks.json
# Run `php bin/generate-jwt-key.php` to create the key at CONSOLE_JWT_PRIVATE_KEY_PATH.
CONSOLE_JWT_ISSUER=console-api
# Must match ai/.env's RUNTIME_TOKEN_AUD / CONSOLE_INTERNAL_JWT_AUD.
RUNTIME_TOKEN_AUDIENCE=ai-runtime
INTERNAL_JWT_AUDIENCE=ai-internal

# --- ai-runtime (internal) ------------------------------------------------
AI_RUNTIME_INTERNAL_BASE_URL=http://ai-runtime.ai-console.svc.cluster.local:8081
AI_RUNTIME_PUBLIC_BASE_URL=http://ai-runtime.ai-console.svc.cluster.local:8080
AI_RUNTIME_INTERNAL_TIMEOUT_SECONDS=10

# --- Crypto / secrets envelope (PRD §7.4, §12) ---------------------------
CONSOLE_MASTER_KEY=changeme_local_dev_only

# --- Misc ------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
