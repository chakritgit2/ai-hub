{
    "name": "dynamiq-console/console-api",
    "description": "Control-plane API for the Dynamiq AI Management Console (PRD-001). Phalcon 5 / PHP 8.1.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-phalcon": "*",
        "ext-pdo": "*",
        "ext-json": "*",
        "robmorgan/phinx": "^0.15",
        "firebase/php-jwt": "^6.10",
        "guzzlehttp/guzzle": "^7.8",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "ConsoleApi\\": "app/"
        },
        "classmap": [
            "app/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "ConsoleApi\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "ext-phalcon": "5.9.3"
        }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S localhost:8091 -t public"
    }
}
