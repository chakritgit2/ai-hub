# --- Database (schema: runtime, logs) ---
DATABASE_URL=postgresql+asyncpg://ai_app:changeme@localhost:5432/ai_console

# --- Dynamiq memory backend: each unset field is derived from DATABASE_URL ---
# MEMORY_DB_HOST=
# MEMORY_DB_PORT=
# MEMORY_DB_NAME=
# MEMORY_DB_USER=
# MEMORY_DB_PASSWORD=

# --- HMAC pepper for hashing end-user identifiers before persisting them (PRD §6.2/§7.5) ---
# Must be changed whenever ENVIRONMENT is not "development" (startup refuses the default).
HASH_PEPPER=changeme_local_dev_only

# --- Redis (queues, rate limiting, quotas) ---
REDIS_URL=redis://localhost:6379/0

# --- LLM providers (Playground dev convenience; production keys live encrypted in
#     runtime.connection_secrets, see app/services/runtime.py and PRD §7.4/7.7) ---
OPENAI_API_KEY=
OPENAI_URL=https://api.openai.com/v1

# --- Auth: console-api -> ai-runtime internal calls (PRD §7.1/7.6) ---
CONSOLE_INTERNAL_JWT_AUD=ai-internal
CONSOLE_INTERNAL_JWT_ISSUER=console-api
CONSOLE_JWKS_URL=http://console-api.internal/admin/.well-known/jwks.json

# --- Auth: web -> ai-runtime Playground runtime token ---
RUNTIME_TOKEN_AUD=ai-runtime

# --- Auth: ai-gateway ---
GATEWAY_API_KEY_PREFIX=ak_
GATEWAY_JWKS_PRIVATE_KEY_PATH=
GATEWAY_JWKS_KID=gw-2026-09

# --- Envelope encryption (PRD §7.7 - per-company DEK wrapped by this master key) ---
# Base64-encoded raw AES key bytes (32 bytes -> AES-256). Generate with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# Optional in local dev (until something touches Connections); required everywhere else.
CONSOLE_MASTER_KEY=

# --- Runtime limits (PRD §6.2) ---
MAX_CONCURRENT_RUNS=16
DEFAULT_MAX_LOOPS=8
MAX_MAX_LOOPS=20
RUN_TIMEOUT_SECONDS=120
CONVERSATION_TTL_DAYS=30

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO

# --- App identity ---
ENVIRONMENT=development
